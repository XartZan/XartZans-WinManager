<UserControl x:Class="XartZans.WinManager.App.Views.ModuleInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource WindowBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="34" VerticalAlignment="Center">
                <Border MaxWidth="760" Padding="32" CornerRadius="16" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                    <StackPanel>
                        <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource AccentMutedBrush}"
                                HorizontalAlignment="Left" Margin="0,0,0,24">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"
                                       FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Background="{DynamicResource WarningMutedBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="14"
                                Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,15">
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource WarningBrush}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="28"
                                   FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource ModulePreparing}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="15"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                   TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" />
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="10"
                                Padding="14" Margin="0,24,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}"
                                           FontSize="13" VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding NextStep}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                           TextWrapping="Wrap" LineHeight="17" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

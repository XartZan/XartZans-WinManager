<UserControl x:Class="XartZans.WinManager.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="30,25,30,28">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource DashboardTitle}" Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource DashboardDescription}" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12" Margin="1,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource PositiveMutedBrush}" BorderBrush="{DynamicResource PositiveBorderBrush}" BorderThickness="1"
                            CornerRadius="18" Padding="12,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{Binding MonitoringStatusBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding MonitoringStatusText}" Foreground="{DynamicResource PositiveBrush}" FontSize="10" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <UniformGrid Columns="4" Margin="-6,0,-6,18">
                <Border Margin="6" Padding="16" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MinHeight="156">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource MetricCpu}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                        </Grid>
                        <TextBlock Text="{Binding CpuValueText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23"
                                   FontWeight="SemiBold" Margin="0,17,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="4" Margin="0,16,0,9" Minimum="0" Maximum="100" Value="{Binding CpuUsagePercent, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}" BorderThickness="0"
                                     Visibility="{Binding HasCpuUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{DynamicResource MetricActiveCaption}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="16" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MinHeight="156">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource GraphicsStatusTitle}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="&#xE950;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                        </Grid>
                        <TextBlock Text="{Binding GraphicsModel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,15,0,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding GraphicsUsageText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                   FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="100"
                                     Value="{Binding GraphicsUsagePercent, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource ProgressTrackBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding HasGraphicsUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{DynamicResource GraphicsUsageDetails}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="8"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="16" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MinHeight="156">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource MetricMemory}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="&#xE964;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource InfoBrush}" FontSize="13" />
                        </Grid>
                        <TextBlock Text="{Binding MemoryValueText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23"
                                   FontWeight="SemiBold" Margin="0,17,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="4" Margin="0,16,0,9" Minimum="0" Maximum="100" Value="{Binding MemoryUsagePercent, Mode=OneWay}"
                                     Foreground="{DynamicResource InfoBrush}" Background="{DynamicResource ProgressTrackBrush}" BorderThickness="0"
                                     Visibility="{Binding HasMemoryUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding MemoryDetailText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <Border Margin="6" Padding="16" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MinHeight="156">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource MetricDisk}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                            <TextBlock Grid.Column="1" Text="&#xE958;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource PositiveBrush}" FontSize="13" />
                        </Grid>
                        <TextBlock Text="{Binding DiskValueText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="23"
                                   FontWeight="SemiBold" Margin="0,17,0,0" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Height="4" Margin="0,16,0,9" Minimum="0" Maximum="100" Value="{Binding DiskUsagePercent, Mode=OneWay}"
                                     Foreground="{DynamicResource PositiveBrush}" Background="{DynamicResource ProgressTrackBrush}" BorderThickness="0"
                                     Visibility="{Binding HasDiskUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding DiskDetailText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.18*" />
                    <ColumnDefinition Width="0.82*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Margin="0,0,9,0" Padding="19" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MinHeight="380">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource SystemOverview}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,0,0,17" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,14">
                                <TextBlock Text="{DynamicResource ComputerName}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding ComputerModelSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,14">
                                <TextBlock Text="{DynamicResource OperatingSystem}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding OperatingSystem}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{DynamicResource OperatingSystemReleaseDate}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="8" />
                                    <TextBlock Text=":" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="8" Margin="2,0,4,0" />
                                    <TextBlock Text="{Binding OperatingSystemReleaseDateText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,14">
                                <TextBlock Text="{DynamicResource ProcessorModel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding ProcessorModel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,14">
                                <TextBlock Text="{DynamicResource GraphicsModel}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding GraphicsModel}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource HardwareMotherboard}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding MotherboardSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,14">
                                <TextBlock Text="{DynamicResource HardwareMemory}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding MemoryModulesSummaryText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="9"
                                           FontWeight="Medium" Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="14" />
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource SystemDrive}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding DiskDetailText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="9"
                                           FontWeight="Medium" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Row="5" Grid.ColumnSpan="2">
                                <TextBlock Text="{DynamicResource LastUpdated}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Text="{Binding LastUpdatedText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10"
                                           FontWeight="Medium" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="9,0,0,0">
                    <Border Padding="17" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MinHeight="142">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="13" />
                                <TextBlock Text="{DynamicResource MetricNetwork}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource InfoBrush}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource NetworkDownload}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="7,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding DownloadText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE74B;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="10" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{DynamicResource NetworkUpload}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="7,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding UploadText}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Text="{DynamicResource MetricActiveCaption}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" Margin="0,13,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Padding="17" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" MinHeight="190" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource WarningBrush}" FontSize="13" />
                                <TextBlock Text="{DynamicResource TemperatureTitle}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource MetricCpu}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Grid.Column="1" Text="{Binding CpuTemperatureText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="10" FontWeight="Medium" TextWrapping="Wrap" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource MetricGpu}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Grid.Column="1" Text="{Binding GpuTemperatureText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="10" FontWeight="Medium" TextWrapping="Wrap" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource MetricMemory}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9" />
                                <TextBlock Grid.Column="1" Text="{Binding MemoryTemperatureText}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="10" FontWeight="Medium" TextWrapping="Wrap" />
                            </Grid>
                            <TextBlock Text="{DynamicResource TemperatureAvailabilityNote}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="8"
                                       TextWrapping="Wrap" Margin="0,11,0,0" />
                            <TextBlock Text="{Binding TemperatureUpdatedText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="8" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Padding="17" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" Margin="0,12,0,0" MinHeight="120">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,11">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="13" />
                                <TextBlock Text="{DynamicResource ActivityTitle}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="{DynamicResource NoActivity}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="10" FontWeight="Medium" />
                            <TextBlock Text="{DynamicResource ActivityDescription}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="9"
                                       TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

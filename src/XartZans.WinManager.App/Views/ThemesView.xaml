<UserControl x:Class="XartZans.WinManager.App.Views.ThemesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="30,25,30,30">
            <TextBlock Text="{DynamicResource ThemeTitle}" Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="27" FontWeight="SemiBold" />
            <TextBlock Text="{DynamicResource ThemeDescription}" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="11" TextWrapping="Wrap" Margin="1,5,0,20" />

            <ItemsControl ItemsSource="{Binding Themes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,12,12" Padding="0" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" HorizontalContentAlignment="Stretch"
                                Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Code}">
                            <Border Padding="19" CornerRadius="14" Background="{DynamicResource PanelBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="100" Height="112" CornerRadius="10" Padding="7"
                                            Background="{Binding PreviewBackground}" BorderBrush="{Binding PreviewAccent}"
                                            BorderThickness="1" HorizontalAlignment="Left">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="14" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="4" Background="{Binding PreviewAccent}" />
                                            <Border Grid.Row="1" Margin="0,6,0,0" CornerRadius="5" Padding="5"
                                                    Background="{Binding PreviewPanel}">
                                                <StackPanel>
                                                    <Border Height="5" CornerRadius="3" Background="{Binding PreviewText}" Opacity="0.85" />
                                                    <Border Height="4" Margin="0,6,18,0" CornerRadius="3"
                                                            Background="{Binding PreviewAccent}" />
                                                    <Border Height="16" Margin="0,7,0,0" CornerRadius="4"
                                                            Background="{Binding PreviewBackground}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="13,2,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <TextBlock Text="{DynamicResource ThemeSelected}" Foreground="{DynamicResource AccentBrush}"
                                                   FontSize="9" FontWeight="SemiBold" Margin="0,10,0,0"
                                                   Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
